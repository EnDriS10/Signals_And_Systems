   "source": [
    "#calcular un promedio\n",
    "\n",
    "import numpy as np\n",
    "\n",
    "lista_entrada=input(\"Introduca una lista de numeros separados por ,\")\n",
    "arr= np.array([float(i) for i in lista_entrada.split(\",\")])\n",
    "\n",
    "pm=0\n",
    "x=0\n",
    "\n",
    "for j in arr:\n",
    "    x +=1\n",
    "    pm=(pm*(x-1) + j)/x\n",
    "\n",
    "print(pm)\n",
    "\n",
    "\n",
    "\n",
    "\n",
    "\n"
   ]
  }
 ],
